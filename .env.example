# fsq-agent loads .env from the repository root and from the selected config file directory.
# Existing process environment variables take precedence over values in this file.

# Optional LLM provider selection. Omit or use github_copilot for local Copilot auth.
# Use azure_openai to read the fixed Azure variables below.
FSQ_LLM_PROVIDER=github_copilot

# Android target app/device values used by dynamic runs and strict cases without appId metadata.
FSQ_ANDROID_APP_ID=com.microsoft.emmx
FSQ_ANDROID_SERIAL=emulator-5554

# Required for Web runs. Point to the local browser executable for the configured channel.
FSQ_WEB_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Required for Windows runs. Optional adapter values tune pywinauto for the target app.
FSQ_WINDOWS_APP_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
FSQ_WINDOWS_BACKEND_KIND=uia
FSQ_WINDOWS_WINDOW_TITLE_RE=.*Microsoft.*Edge.*
FSQ_WINDOWS_LAUNCH_ARGS=--no-first-run --disable-features=msImplicitSignin

# Required for macOS Appium Mac2 runs. Provide the Appium server URL and either
# FSQ_MACOS_BUNDLE_ID or FSQ_MACOS_APP_PATH for the target application.
FSQ_MACOS_APPIUM_SERVER_URL=http://127.0.0.1:4723
FSQ_MACOS_BUNDLE_ID=com.microsoft.edgemac
FSQ_MACOS_APP_PATH=/Applications/Microsoft Edge.app

# Required only when openai_agents.provider is azure_openai.
AZURE_OPENAI_BASE_URL=https://example-openai.openai.azure.com/openai/v1/
AZURE_OPENAI_MODEL=gpt-5.4
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-api-key

# Required only for account-dependent tasks that list these names in
# runtime_secrets.allowed_env_names. Leave blank or remove when not needed.
TEST_ACCOUNT_EMAIL=edge-test@example.com
TEST_ACCOUNT_PASSWORD=replace-with-your-test-account-password
